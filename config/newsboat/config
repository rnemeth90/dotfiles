# Newsboat configuration
# This file is installed into ~/.newsboat/config during setup.

auto-reload yes
reload-threads 8
html-renderer internal
browser "w3m %u"
show-read-feeds no
download-path "~/Downloads"

# Kanagawa Wave terminal palette
color background default default
color listnormal color7 default
color listnormal_unread color15 default bold
color listfocus color0 color6 bold
color listfocus_unread color0 color3 bold
color info color7 color0
color article color7 default
color title color15 default bold
color hint-key color6 default bold
color hint-separator color8 default
color hint-description color7 default

highlight article "^(Feed|Link):.*$" color6 default bold
highlight article "^(Title|Date|Author):.*$" color3 default bold
highlight article "https?://[^ ]+" color4 default underline
