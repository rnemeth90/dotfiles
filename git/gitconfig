[include]
    path = ~/.gitconfig.local

[core]
    pager = delta
    autocrlf = input
    whitespace = fix,space-before-tab,tab-in-indent,trailing-space

[delta]
    navigate = true
    dark = true
    side-by-side = true
    line-numbers = true
    syntax-theme = kanagawa

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictstyle = zdiff3
    tool = nvimdiff

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[fetch]
    prune = true

[rebase]
    autoStash = true
    autoSquash = true

[rerere]
    enabled = true

[branch]
    sort = -committerdate

[column]
    ui = auto

[diff]
    algorithm = histogram
    colorMoved = default

[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[credential]
	helper = !gh auth git-credential

[alias]
    # Commit staged changes with automatic conventional commit prefixes
    cm = "!f() { git commit -m \"$1: $2\"; }; f"
    
    # Micro-commit workflow: stage individual files and commit them instantly
    micro = "!f() { for file in $(git diff --name-only); do git add \"$file\" && git commit -m \"update to $file\"; done; }; f"

    # Micro-commit every modified file individually
    # split-commit = "!f() { for f in $(git diff --name-only); do git add \"$f\" && git commit -m \"update to file $f\"; done; }; f"
