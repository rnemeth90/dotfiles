[include]
    path = ~/.gitconfig.local

[core]
    pager = delta
    autocrlf = input
    whitespace = fix,space-before-tab,tab-in-indent,trailing-space

[delta]
    navigate = true
    dark = true
    side-by-side = true
    line-numbers = true
    syntax-theme = kanagawa

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictstyle = zdiff3
    tool = nvimdiff

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[fetch]
    prune = true

[rebase]
    autoStash = true
    autoSquash = true

[rerere]
    enabled = true

[branch]
    sort = -committerdate

[column]
    ui = auto

[diff]
    algorithm = histogram
    colorMoved = default

[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
