#!/bin/bash
# https://www.gnu.org/software/bash/manual/html_node/Bash-Variables.html

# ==== History Configuration ====
export HISTCONTROL=ignoreboth:ignoredups
export HISTFILESIZE=10000
export HISTSIZE=10000
export HISTIGNORE="&:[bf]g:c:clear:history:exit:q:pwd:* --help"
export PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

# ==== Locale / Encoding ====
export PYTHONIOENCODING="UTF-8"
# export LANG=en_US.UTF-8
# export LC_ALL=en_US.UTF-8

# ==== Man Page & Less ====
# Hardcoded ANSI codes instead of `tput` (3 subprocess+terminfo lookups,
# ~0.1s) — bold+green and reset, matching the raw-escape style already
# used in bash_prompt.
export LESS_TERMCAP_md=$'\e[1m\e[32m'
export LESS_TERMCAP_me=$'\e[0m'
export MANPAGER="less -X"

# ==== Node.js ====
export NODE_REPL_HISTORY_SIZE=10000
NPM_PACKAGES="${HOME}/.npm-packages"
export PATH="$PATH:$NPM_PACKAGES/bin"
# Prepend the npm man path and leave a trailing empty MANPATH component
# (the trailing colon) so `man` still falls back to its compiled-in
# default search path. This avoids calling `manpath` (~0.4s: it rebuilds
# the whole man search path from /etc/man.conf + filesystem scan) on
# every single shell start.
export MANPATH="$NPM_PACKAGES/share/man:${MANPATH}:"

# ==== fzf ====
FZF_EXCLUDE_DIRS=(Applications Library Movies Music Pictures Qt node_modules venv .DS_Store .Trash .cache .git .mypy_cache .npm .pyenv .pytest_cache .stack .temp __pycache__)
FZF_EXCLUDE_FLAGS=""
for _d in "${FZF_EXCLUDE_DIRS[@]}"; do FZF_EXCLUDE_FLAGS+=" --exclude ${_d}"; done
export FZF_DEFAULT_COMMAND="command fd --hidden --no-ignore${FZF_EXCLUDE_FLAGS} ."
export FZF_DEFAULT_OPTS='--ansi --preview "bat --color=always --style=header,grid --line-range :300 {}"'
export FZF_ALT_C_COMMAND="command fd --type d --type l --hidden --no-ignore${FZF_EXCLUDE_FLAGS} ."
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_COMPLETION_TRIGGER='**'

# ==== Shell ====
export SHELL="/bin/bash"

# ==== Directory Locations ====
export XDG_CONFIG_HOME="$HOME/.config"
export TMUX_CONF="$XDG_CONFIG_HOME/tmux/tmux.conf"
export SSH_KEY_PATH="$HOME/.ssh/rsa_id"

# ==== Language & Toolchains ====

# nvm (lazy-loaded: sourcing nvm.sh eagerly is slow on every shell start)
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  _load_nvm() {
    unset -f nvm node npm npx _load_nvm
    \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  }
  nvm()  { _load_nvm; nvm "$@"; }
  node() { _load_nvm; node "$@"; }
  npm()  { _load_nvm; npm "$@"; }
  npx()  { _load_nvm; npx "$@"; }
fi

# pyenv (lazy-loaded: `eval "$(pyenv init -)"` spawns a subprocess on every shell start)
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv &>/dev/null; then
  pyenv() {
    unset -f pyenv
    eval "$(command pyenv init -)"
    pyenv "$@"
  }
fi

# poetry
export PATH="$HOME/.poetry/bin:$PATH"

# deno
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"

# go
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export PATH="$GOBIN:$PATH"
export GOMODCACHE="$HOME/.cache/go/pkg/mod"

# dotnet — path differs by OS
if [[ "$(uname)" == "Darwin" ]]; then
  export DOTNET_ROOT="/usr/local/share/dotnet"
else
  export DOTNET_ROOT="/usr/share/dotnet"
fi
export PATH="$DOTNET_ROOT:$PATH"

# krew / Kubernetes
export KUBE_EDITOR=nvim
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# rust / cargo
export PATH="${CARGO_ROOT:-$HOME/.cargo}/bin:$PATH"

# ==== System PATH Setup ====

if [[ "$(uname)" == "Darwin" ]]; then
  # macOS: Homebrew coreutils, Homebrew bin, Julia
  export BASH_SILENCE_DEPRECATION_WARNING=1
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:/opt/homebrew/bin:/opt/julia/julia-1.8.5/bin:$PATH"

  # Cache the Homebrew prefix once so other startup files (e.g.
  # bash_autocompletion) don't need to shell out to `brew --prefix`
  # (a slow Ruby subprocess) on every new shell/tmux window.
  export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
fi

# local bin + standard system paths
export PATH="$HOME/bin:/usr/local/bin:/usr/local/go/bin:$PATH"

# Add any /usr/bin/*/bin dynamically
for d in /usr/bin/*/bin; do [ -d "$d" ] && PATH="$PATH:$d"; done
